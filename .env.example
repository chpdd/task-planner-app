# ===========================================
# Task Planner - Environment Configuration
# ===========================================

# Environment type (dev/prod)
ENV_TYPE=dev

# Application mode
MODE=dev

# ===========================================
# Database Configuration
# ===========================================
DB_NAME=task_planner_db
DB_USER=admin
DB_PASS=changeme123
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# Redis Configuration (planner service)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Token expiration (optional - defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Default Values (optional - defaults shown)
# ===========================================
# default_day_work_hours=4
# default_task_work_hours=2
# default_interest=5
# default_importance=5
